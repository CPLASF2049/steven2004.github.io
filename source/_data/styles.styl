// ================================================================
// 自定义样式（在 _config.next.yml 的 custom_file_path.style 中启用）
// 语法是 Stylus，缩进即层级，不需要大括号和分号。
// 文档：https://theme-next.js.org/docs/advanced-settings/custom-files
// ================================================================

// ---- 中文字体优化：优先使用系统自带的现代中文字体 ----
body
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Source Han Sans SC", "Noto Sans CJK SC", sans-serif

// ---- 文章内图片：居中显示并留出上下间距 ----
.post-body img
  display: block
  margin: 1.2rem auto
  border-radius: 6px

// ---- 引用块：换成品牌色左边框，视觉上更清爽 ----
blockquote
  border-left: 4px solid #37c6c0
  background-color: rgba(55, 198, 192, 0.06)
  padding: 8px 16px
  border-radius: 0 4px 4px 0

// ---- 行内代码：加深底色，和正文区分更明显 ----
code
  padding: 2px 5px
  border-radius: 4px

// ---- 表格：铺满内容宽度，表头加重 ----
table
  width: 100%

  th
    background-color: rgba(55, 198, 192, 0.08)

// ---- 首页文章标题：hover 时用品牌色 ----
.posts-expand .post-title-link:hover
  color: #37c6c0

// ---- 文章目录当前项高亮 ----
.post-toc .nav .active > a
  color: #37c6c0
  font-weight: 600
