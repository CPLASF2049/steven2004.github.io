<%
const isArchive = params.key === 'archive';
const name = isArchive ? (page.year ? String(page.year) + (page.month ? ' · ' + page.month + ' 月' : '') : '文章归档') : (page.category || page.tag);
%>
<section class="inner-section archive-journal">
  <nav class="inner-breadcrumb" aria-label="当前位置"><a href="<%= url_for('/') %>">首页</a><span aria-hidden="true">/</span><% if (!isArchive) { %><a href="<%= url_for(params.key === 'category' ? '/categories/' : '/tags/') %>"><%= params.key === 'category' ? '分类' : '标签' %></a><span aria-hidden="true">/</span><% } %><span aria-current="page"><%= name %></span></nav>
  <header class="inner-heading"><div><p class="inner-eyebrow"><%= isArchive ? 'THE ARCHIVE' : 'EXPLORE THE JOURNAL' %></p><h1><%= name %></h1><p><%= isArchive ? '把走过的路，写成可以回看的文字。' : '沿着一个主题，发现更多记录。' %></p></div><span class="inner-count"><strong><%= params.postTotal %></strong> 篇文章</span></header>
  <nav class="inner-tabs" aria-label="浏览方式"><a class="<%= isArchive ? 'is-current' : '' %>" href="<%= url_for('/archives/') %>">按时间</a><a class="<%= params.key === 'category' ? 'is-current' : '' %>" href="<%= url_for('/categories/') %>">按分类</a><a class="<%= params.key === 'tag' ? 'is-current' : '' %>" href="<%= url_for('/tags/') %>">按标签</a></nav>
  <div class="archive-timeline">
  <% let cursor; page.posts.each(function(post) { const year = date(post.date,'YYYY'); if (year !== cursor) { cursor = year; %><h2 class="archive-year"><span><%= year %></span><span class="archive-year-line" aria-hidden="true"></span></h2><% } %>
    <article class="archive-entry">
      <time datetime="<%= date(post.date,'YYYY-MM-DD') %>"><span><%= date(post.date,'MM') %> 月</span><strong><%= date(post.date,'DD') %></strong></time>
      <div class="archive-entry-body"><h3><a href="<%= url_for(post.path) %>"><%= post.title %></a></h3><p><%= strip_html(post.description || post.excerpt || '').substring(0,140) %></p><div class="archive-entry-meta"><% post.categories.limit(1).each(function(cat) { %><a href="<%= url_for(cat.path) %>"><%= cat.name %></a><% }); %><% post.tags.limit(2).each(function(tag) { %><a href="<%= url_for(tag.path) %>"># <%= tag.name %></a><% }); %></div></div>
      <a class="archive-open" href="<%= url_for(post.path) %>" aria-label="阅读：<%= post.title %>"><span aria-hidden="true">↗</span></a>
    </article>
  <% }); %>
  </div>
  <% if (!page.posts.length) { %><p class="inner-empty">这里还没有文章，去 <a href="<%= url_for('/archives/') %>">全部归档</a> 看看吧。</p><% } %>
  <%- partial('_partials/paginator') %>
</section>
