<div class="reading-toolbar"><nav class="inner-breadcrumb" aria-label="当前位置"><a href="<%= url_for('/') %>">首页</a><span aria-hidden="true">/</span><a href="<%= url_for('/archives/') %>">文章</a><% if (page.categories && page.categories.length) { const cat = page.categories.first(); %><span aria-hidden="true">/</span><a href="<%= url_for(cat.path) %>"><%= cat.name %></a><% } %></nav><a href="#board" class="reading-mark">阅读正文 <span aria-hidden="true">↓</span></a></div>
<% const mobileToc = toc(page.content, {class:'mobile-outline',list_number:false,max_depth:3}); if (mobileToc) { %>
<details class="mobile-reading-toc"><summary><span><i class="iconfont icon-list" aria-hidden="true"></i> 本文目录</span><span class="mobile-toc-hint">展开 / 收起</span></summary><nav aria-label="文章章节"><%- mobileToc %></nav></details>
<% } %>
